# Copy this file to .env.local and fill in values.

DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

HOUSEHOLD_PASSWORD=change-me
HOUSEHOLD_SESSION_SECRET=generate-a-long-random-string

TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=generate-a-random-secret
# Comma-separated Telegram user IDs allowed to save links
TELEGRAM_ALLOWED_USER_IDS=

# Multi-link auto-tag (Google AI Studio)
GEMINI_API_KEY=
# Optional overrides:
# GEMINI_MODEL=gemini-3.1-flash-lite
# GEMINI_CONFIDENCE_THRESHOLD=0.7
# GEMINI_BATCH_MAX=5

# Daily food recommendations (RAG v1 — SQL tag filter, not inventing recipes)
CRON_SECRET=
# Comma-separated top-tag slugs used to retrieve cooking candidates
FOOD_TAG_SLUGS=recipes,recipe,cooking,food
# Friday movie recommendations (7PM IST Fridays; exclude watched)
MOVIE_TAG_SLUGS=movies,movie,films,film
# Optional: send digest to one chat instead of each TELEGRAM_ALLOWED_USER_IDS
# TELEGRAM_DIGEST_CHAT_ID=
